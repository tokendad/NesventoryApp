<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext (HTTP) stays enabled so user-configured LAN IPs continue to work.
        Runtime enforcement in NetworkModule only permits HTTP for localhost/private
        network hosts and rejects non-LAN cleartext targets.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
