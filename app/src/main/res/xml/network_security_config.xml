<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext (HTTP) is permitted to support user-configured LAN servers
        that may not have TLS certificates. The OkHttp Host Selection Interceptor
        rewrites URLs at runtime, so static domain filtering is not feasible.
        Remote server connections should always use HTTPS.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
